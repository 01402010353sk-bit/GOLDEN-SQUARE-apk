rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the caller is the specific user
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check admin role via custom claims or trusted token
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'ADMIN');
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId) && request.resource.data.role != 'ADMIN';
      allow update: if isUser(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdAt'])) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Teams Collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      // Only server functions or admins can modify goldPoints balances
      allow create: if isAuthenticated() && !request.resource.data.keys().hasAny(['goldPoints']) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.captainUserId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['goldPoints', 'isSuspended', 'monthlyRewardLastClaimedMonth'])) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Transactions Collection (IMMUTABLE AUDITED LEDGER)
    // Direct client writes are strictly forbidden. All balance changes are executed via Cloud Functions.
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.teamId in request.auth.token.teamIds || isAdmin());
      allow write: if false; // Only Cloud Functions using Admin SDK can create ledger records
    }
    
    // Custom Room Slots Collection
    match /customSlots/{slotId} {
      allow read: if isAuthenticated();
      // Clients cannot directly write published slots without 50 GP atomic fee deduction
      allow create, update, delete: if isAdmin();
      
      // Private room credentials subcollection: strictly guarded
      match /privateCredentials/{credId} {
        allow read: if isAuthenticated() && (
          resource.data.hostCaptainUserId == request.auth.uid ||
          request.auth.uid in resource.data.approvedParticipantUserIds ||
          isAdmin()
        );
        allow write: if isAdmin();
      }
      
      // Join Requests subcollection
      match /joinRequests/{reqId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/customSlots/$(slotId)).data.hostCaptainUserId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }
    
    // Admin Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Admin SDK Cloud Functions can append audit records
    }
  }
}
